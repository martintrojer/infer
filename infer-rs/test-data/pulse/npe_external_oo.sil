// Merged from npeWithExternalObjOrient.sil + externalObjOrientRetNull.sil
// Tests interprocedural OO dispatch with separate compilation.

.source_language = "java"

type ClassA = { value:int; next: *ClassA }

// External method definitions (from externalObjOrientRetNull.sil)

define ClassA.external_returns_null(this: *ClassA) : *ClassA {
  #entry:
    ret null
}

define ClassA.external_returns_non_null(this: *ClassA) : *ClassA {
  #entry:
    n0: *ClassA = load &this
    ret n0
}

// Callers (from npeWithExternalObjOrient.sil)

define external_call_a_OK(this: *ClassA) : void {
  #entry:
    n0: *ClassA = load &this
    n1 = n0.ClassA.external_returns_null()
    ret null
}

define external_call_b_OK(this: *ClassA) : void {
  #entry:
    n0: *ClassA = load &this
    n1  = n0.ClassA.external_returns_non_null()
    n2: int = load n1.ClassA.value
    ret n2
}

define external_call_and_npe_bad(this: *ClassA) : int {
  #entry:
    n0: *ClassA = load &this
    n1  = n0.ClassA.external_returns_null()
    n2: int = load n1.ClassA.value
    ret n2
}
